{
    "name": "custom-module-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "install-deps": "npm cache clean @stringeecom/ui-kit@1.0.0 && rm -rf node_modules && npm i @stringeecom/ui-kit@1.0.0 --force && npm i",
        "install-deps:dev": "npm i @stringeecom/ui-kit@1.0.0 --force && npm i",
        "generate-i18n-files": "node ./src/languages/generate-i18n-files.js && npx prettier ./src/languages --write",
        "precommit": "npm run build"
    },
    "dependencies": {
        "@fontsource-variable/nunito": "^5.0.17",
        "@hookform/resolvers": "^3.9.0",
        "@juggle/resize-observer": "^3.4.0",
        "@reduxjs/toolkit": "^2.2.1",
        "@stringeecom/ui-kit": "^1.0.0",
        "@tanstack/react-query": "^5.22.2",
        "@tanstack/react-query-devtools": "^5.24.0",
        "axios": "^1.6.7",
        "classnames": "^2.5.1",
        "dayjs": "^1.11.10",
        "i18next": "^23.9.0",
        "i18next-browser-languagedetector": "^7.2.0",
        "i18next-chained-backend": "^4.6.2",
        "i18next-fs-backend": "^2.6.0",
        "i18next-http-backend": "^3.0.1",
        "lodash": "^4.17.21",
        "object-path": "^0.11.8",
        "object-to-formdata": "^4.5.1",
        "qs": "^6.12.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.50.1",
        "react-i18next": "^14.0.5",
        "react-redux": "^9.1.0",
        "react-router-dom": "^6.22.1",
        "react-scan": "^0.3.4",
        "sass": "^1.71.1",
        "tailwind-merge": "^2.2.1",
        "usehooks-ts": "^2.15.1",
        "uuid": "^10.0.0",
        "yup": "^1.4.0"
    },
    "devDependencies": {
        "@originjs/vite-plugin-federation": "^1.1.2",
        "@swc/cli": "^0.3.12",
        "@swc/core": "^1.5.5",
        "@tailwindcss/typography": "^0.5.13",
        "@tanstack/eslint-plugin-query": "^5.20.1",
        "@types/lodash": "^4.14.202",
        "@types/node": "^20.11.20",
        "@types/object-path": "^0.11.4",
        "@types/qs": "^6.9.15",
        "@types/react": "^18.2.56",
        "@types/react-dom": "^18.2.19",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.2",
        "@typescript-eslint/parser": "^7.0.2",
        "@vitejs/plugin-basic-ssl": "^1.1.0",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitejs/plugin-react-swc": "^3.6.0",
        "autoprefixer": "^10.4.17",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "googleapis": "^144.0.0",
        "less": "^4.2.0",
        "postcss": "^8.4.35",
        "prettier": "^3.2.5",
        "simple-git": "^3.27.0",
        "tailwindcss": "^3.4.1",
        "type-fest": "^4.26.1",
        "typescript": "^5.2.2",
        "vite": "^5.1.4",
        "vite-plugin-eslint": "^1.8.1"
